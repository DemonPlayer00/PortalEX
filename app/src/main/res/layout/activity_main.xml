<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      抽屉 = 两个 NavigationView：
        · 上面是日常入口（含 header）；
        · 下面是工具页（校准/诊断），与上面隔开 **1/4 个按钮高度**。
      为什么不用一个菜单里的 subheader 占位：subheader 的行高被 Material 固定成
      ?attr/listPreferredItemHeightSmall（本机 48dp）——那正好是"一个按钮"的高度，
      改它又会连带把 menu item 的 minHeight 一起改掉。分成两个视图后间距就是 margin，
      精确可控。容器背景取 M3 抽屉容器色（?attr/colorSurfaceContainerLow），
      让那 12dp 缝隙看起来仍是同一块抽屉面。
    -->
    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceContainerLow">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:headerLayout="@layout/nav_header_main"
            app:itemVerticalPadding="0dp"
            app:menu="@menu/activity_main_drawer" />

        <!--
          两组菜单之间：**细分隔线**（1dp，M3 缩进 28dp 与颜色）。
          画在工具页的 `foreground` 上，不塞独立的 View —— 容器宽度是 wrap_content：
          · match_parent 的 View 会把抽屉撑到满屏宽；
          · 0dp+weight 在**纵向** LinearLayout 里分配的是高度（实测把工具组推到了屏幕底部）。
          线下方不再额外留白：紧贴线的就是工具组第一项（Calibration）；线上方保留 4dp margin
          （加上顶部视图固有的 8dp 底留白）。
        -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:foreground="@drawable/drawer_divider_line"
            app:menu="@menu/activity_main_drawer_tools" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>