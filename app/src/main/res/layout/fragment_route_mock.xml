<?xml version="1.0" encoding="utf-8"?>
<!--
  路线模拟页（M3 大色块版）：
    · 主控区 = 一整块 primaryContainer（PortalHeroCard）：目标路线、启用开关、
      悬浮摇杆开关都落在色块上，不再用"启动模拟"按钮模拟开关；
    · 历史路线列表 = surfaceContainerLow 大块（PortalSurfaceCard）；
    · 颜色只取主题角色 ⇒ 莫奈取色下随壁纸变化。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.mock.MockFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mock_location_card"
            style="@style/PortalHeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/page_gutter"
            android:layout_marginEnd="@dimen/page_gutter"
            app:cardPreventCornerOverlap="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_route"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/mock_route_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/none_route"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold" />

                <!-- M3 开关：选中 = 模拟正在运行（不再用按钮文字表达开关态） -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_mock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="@string/route_mock_enable"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:thumbTint="@color/portal_switch_thumb_on_container"
                    app:trackTint="@color/portal_switch_track_on_container" />

                <!-- 悬浮摇杆：同一块主控区里的次级开关（状态源仍是 ViewModel.rocker） -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/rocker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/rocker"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:thumbTint="@color/portal_switch_thumb_on_container"
                    app:trackTint="@color/portal_switch_track_on_container" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/historical_route_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_label_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/history_label_margin"
            android:layout_marginBottom="6dp"
            android:text="@string/history_route"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historical_route_card"
            style="@style/PortalSurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="160dp"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginEnd="@dimen/page_gutter"
            android:layout_marginBottom="@dimen/page_gutter"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historical_route_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_mock_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:contentDescription="@string/follow_location"
        android:tint="?attr/colorOnPrimaryContainer"
        android:visibility="gone"
        app:fabSize="auto"
        app:shapeAppearanceOverlay="@style/PortalFabCircularOverlay"
        app:srcCompat="@drawable/sharp_location_off_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
