<?xml version="1.0" encoding="utf-8"?>
<!--
  摄像头模拟页（M3 大色块版）：
    · 顶部主控区 = 一整块 primaryContainer（Portal.HeroCard），标题/状态/开关/实现管理
      全部落在色块上，不再给每个控件单独描边或套卡片；
    · 颜色只取主题角色（?attr/colorXxx）⇒ 莫奈取色（Android 12+）随壁纸变化，
      低版本退回主题里的品牌灰；夜间主题同名继承；
    · 开关用 MaterialSwitch（M3），动作按钮用 Filled / Tonal / TextButton 三档层级。
  启动开关在 app 侧只做一件事：把清单里的 enabled 置位并通过 provider 下发给被注入的进程。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.camera.CameraMockFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ 主控大色块 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_mock_card"
            style="@style/PortalHeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/page_gutter"
            android:layout_marginEnd="@dimen/page_gutter"
            app:cardPreventCornerOverlap="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 页面标题已在顶栏，这里不重复；右上角只放"地图 / 说明"两个轻动作 -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_map_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:text="@string/camera_mock_show_map"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <ImageButton
                        android:id="@+id/camera_mock_info"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/camera_mock_info"
                        android:src="@drawable/baseline_info_outline_24"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </LinearLayout>

                <!-- 状态 = 这一块里唯一的大字：用户只需要一眼看出"开没开" -->
                <TextView
                    android:id="@+id/camera_mock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold"
                    tools:text="未启动" />

                <TextView
                    android:id="@+id/camera_mock_impl_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:text="需要安装摄像头实现"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <!-- M3 开关：选中 = 正在运行；文字只说明"这是什么"，不随状态改变 -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_camera_mock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="@string/camera_mock_enable"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:thumbTint="@color/portal_switch_thumb_on_container"
                    app:trackTint="@color/portal_switch_track_on_container" />

                <!-- 实现管理：Tonal 按钮，处于主控色块内仍保持层级低于开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_import_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="导入"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_update_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="更新"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_uninstall_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="卸载"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            地图卡：与路线编辑页同一套地图操作（可拖动/缩放/切卫星图），
            把「点位」和「当前表象位置」画在同一张图上 —— 用户一眼就能看出
            "现在会播哪个点"，这正是选片规则（最近命中点）的可视化。
            默认**收起**：展开后地图会吃掉 180dp，把下面的列表挤到只剩一条缝。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_mock_map_card"
            style="@style/PortalSurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/page_gutter"
            android:visibility="gone"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="0dp">

            <com.baidu.mapapi.map.MapView
                android:id="@+id/camera_mock_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_label_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/history_label_margin"
            android:text="@string/camera_mock_filter_label"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/camera_mock_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleSelection="false" />

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camera_mock_create_tag"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="更多操作"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/camera_point_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_label_margin"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/history_label_margin"
            android:layout_marginBottom="6dp"
            android:text="@string/camera_point_list"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!--
            列表卡：0dp + weight=1 = 「吃掉剩余高度」。**不能写 match_parent** ——
            竖屏 LinearLayout 里 match_parent 是"和父容器一样高"，上面几张卡一变高
            列表就被整体挤出屏幕。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_point_card"
            style="@style/PortalSurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="160dp"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/page_gutter"
            android:layout_marginBottom="8dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/camera_point_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
