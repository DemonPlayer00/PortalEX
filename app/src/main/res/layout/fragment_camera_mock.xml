<?xml version="1.0" encoding="utf-8"?>
<!--
  摄像头模拟页：与路线模拟页同构（顶部一张状态卡 + 标签筛选 + 下方列表卡），
  只是列表内容换成「地图视频点」。启动开关在 app 侧只做一件事：
  把清单里的 enabled 置位并通过 provider 下发给被注入的进程 —— 没有本地服务要起。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.camera.CameraMockFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_mock_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/camera_mock"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_map_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/camera_mock_show_map"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                    <ImageButton
                        android:id="@+id/camera_mock_info"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/camera_mock_info"
                        android:src="@drawable/baseline_info_outline_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/camera_mock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="未启动" />

                <TextView
                    android:id="@+id/camera_mock_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="" />



                <TextView
                    android:id="@+id/camera_mock_impl_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="需要安装摄像头实现"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_import_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="导入"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_update_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="更新"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera_mock_uninstall_impl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="卸载"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/switch_camera_mock"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1.35"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:padding="4dp"
                        android:text="@string/camera_mock_start"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/rounded_play_arrow_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnPrimary" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            地图卡：与路线编辑页同一套地图操作（可拖动/缩放/切卫星图），
            把「视频点」和「当前表象位置」画在同一张图上 —— 用户一眼就能看出
            "现在会播哪个点"，这正是选片规则（最近命中点）的可视化。
            默认**收起**：展开后地图会吃掉 180dp，实测把下面的列表卡（0dp/weight=1）
            挤到只剩一条缝（点位的名字/坐标/标签全看不见）。所以做成"一键展开/收起"，
            默认保证列表可用，要看"点在哪儿、我在哪儿"时再展开。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_mock_map_card"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:visibility="gone"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardPreventCornerOverlap="false">

            <com.baidu.mapapi.map.MapView
                android:id="@+id/camera_mock_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_label_margin"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/history_label_margin"
            android:text="@string/camera_mock_filter_label"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camera_mock_create_tag"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="创建标签"
                android:textSize="12sp" />

        </LinearLayout>

        <!--  标签筛选：预设标签 + 库内出现过的自定义标签；多选，全含语义  -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/camera_mock_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            app:chipSpacingVertical="0dp"
            app:singleSelection="false" />

        <TextView
            android:id="@+id/camera_point_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_label_margin"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/history_label_margin"
            android:layout_marginBottom="4dp"
            android:text="@string/camera_point_list"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!--
            列表卡：0dp + weight=1 = 「吃掉剩余高度」。**不能写 match_parent** ——
            竖屏 LinearLayout 里 match_parent 是"和父容器一样高"，上面几张卡一变高
            （例如状态栏多出一行"当前模拟位置"）列表就被整体挤出屏幕，实测第一版就是这样：
            明明有 1 个点位，列表里什么都看不见。
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_point_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="160dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/camera_point_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
