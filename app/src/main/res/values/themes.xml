<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 主题（现代设计语言）：保留 Portal 品牌深灰主色 -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- M3 语义色：品牌灰 -->
        <item name="colorPrimary">#5F5F5F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E0E0</item>
        <item name="colorOnPrimaryContainer">#1E1E1E</item>
        <item name="colorSecondary">#494949</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E7E7E7</item>
        <item name="colorOnSecondaryContainer">#2A2A2A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="colorSurfaceVariant">#F0F0F0</item>
        <item name="colorOnSurfaceVariant">#5F5F5F</item>
        <item name="colorOutline">#747474</item>
        <!-- M3 表面容器角色（大色块的分层依据）。不写就用 material 库自带的中性色，
             与这里的品牌灰不同源；莫奈取色时这些值会被壁纸色覆盖。 -->
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F7F7F7</item>
        <item name="colorSurfaceContainer">#F0F0F0</item>
        <item name="colorSurfaceContainerHigh">#E8E8E8</item>
        <item name="colorSurfaceContainerHighest">#E0E0E0</item>

        <!-- 悬浮胶囊图标色（FabBarView 取色）：浅色 90% 深度黑 -->
        <item name="portalFabIconTint">#1A1A1A</item>

        <!-- 窗口：透明状态栏 + 内容延伸 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 组件样式 -->
        <item name="searchViewStyle">@style/Portal.SearchViewStyle</item>
        <item name="sliderStyle">@style/Portal.SliderTheme</item>
        <item name="android:popupMenuStyle">@style/PortalPopupMenuStyle</item>
        <!-- 开关统一使用 MaterialSwitch（圆点完全落在槽内，见 components 注释）。
             不再覆写 switchStyle：留着它只会让将来误加的 SwitchCompat 长得和别处不一样。 -->
        <item name="materialCardViewStyle">@style/PortalCardStyle</item>
    </style>

    <!--
      开关（统一口径）：**所有开关都用 `com.google.android.material.materialswitch.MaterialSwitch`**
      —— 它是 M3 的"圆点完全落在槽内"那一款，与摄像头模拟页一致；`SwitchCompat`/`SwitchMaterial`
      的滑块会压在槽外，不再使用。落在 hero 色块上的开关用
      `@color/portal_switch_track_on_container` / `@color/portal_switch_thumb_on_container`
      取得与色块的对比，其余位置用 MaterialSwitch 默认的主题角色颜色（莫奈取色自动跟随）。
    -->

    <!--
      M3「大色块」默认卡片：所有没显式指定样式的 MaterialCardView 都走这里
      （surfaceContainerLow + 24dp 圆角 + 0 阴影 + 无线框）。需要主控色块时用
      PortalHeroCard 显式覆盖；列表容器用 PortalSurfaceCard。
    -->
    <style name="PortalCardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!--
      M3「大色块」：页面主控区。整块铺 primaryContainer，按钮/开关直接落在色块上，
      不再给每个控件单独描边或套卡片。

      颜色全部走主题角色 ⇒ 莫奈取色（Android 12+）会随壁纸整块变化；
      低版本/无壁纸取色时退回主题里固定的品牌灰。夜间主题同名继承，无需另写一份。
    -->
    <style name="PortalHeroCard" parent="">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- 列表/内容区大色块：低饱和容器色，让内容浮在页面上而不是被边框围住 -->
    <style name="PortalSurfaceCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- PopupMenu 展开动画：从右上角缩放展开/缩回（右上锚点 pivot 100%/0%） -->
    <style name="PortalPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_in_top_end</item>
        <item name="android:windowExitAnimation">@anim/popup_out_top_end</item>
    </style>

    <style name="PortalPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupAnimationStyle">@style/PortalPopupAnimation</item>
    </style>

    <style name="Portal.SliderTheme" parent="Widget.Material3.Slider" />

    <style name="Portal.SearchViewStyle" parent="Widget.AppCompat.SearchView" />

    <!-- 悬浮按钮（FAB）圆形形状覆盖：任何主题下保持圆形 -->
    <style name="PortalFabCircularOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- M3 顶栏/弹窗 overlay：surface 顶栏（现代范式，顶栏与内容同底色） -->
    <style name="AppTheme.Portal.ToolBarOverlay" parent="ThemeOverlay.Material3.Toolbar.Surface" />

    <style name="AppTheme.Portal.PopupTheme" parent="ThemeOverlay.Material3.Light" />

    <!-- 深色主题（兼容旧引用 AppTheme.Dark） -->
    <style name="AppTheme.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTintMode">src_atop</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTintMode">src_atop</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="CardViewStyle.Dark" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_dark</item>
    </style>

    <style name="CardViewStyle.Light" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_light</item>
    </style>

    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>
