<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 主题（现代设计语言）：保留 Portal 品牌深灰主色 -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- M3 语义色：品牌灰 -->
        <item name="colorPrimary">#5F5F5F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E0E0</item>
        <item name="colorOnPrimaryContainer">#1E1E1E</item>
        <item name="colorSecondary">#494949</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E7E7E7</item>
        <item name="colorOnSecondaryContainer">#2A2A2A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="colorSurfaceVariant">#F0F0F0</item>
        <item name="colorOnSurfaceVariant">#5F5F5F</item>
        <item name="colorOutline">#747474</item>

        <!-- 窗口：透明状态栏 + 内容延伸 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 组件样式 -->
        <item name="searchViewStyle">@style/Portal.SearchViewStyle</item>
        <item name="sliderStyle">@style/Portal.SliderTheme</item>
    </style>

    <style name="Portal.SliderTheme" parent="Widget.Material3.Slider" />

    <style name="Portal.SearchViewStyle" parent="Widget.AppCompat.SearchView" />

    <!-- 悬浮按钮（FAB）圆形形状覆盖：任何主题下保持圆形 -->
    <style name="PortalFabCircularOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- M3 顶栏/弹窗 overlay：surface 顶栏（现代范式，顶栏与内容同底色） -->
    <style name="AppTheme.Portal.ToolBarOverlay" parent="ThemeOverlay.Material3.Toolbar.Surface" />

    <style name="AppTheme.Portal.PopupTheme" parent="ThemeOverlay.Material3.Light" />

    <!-- 深色主题（兼容旧引用 AppTheme.Dark） -->
    <style name="AppTheme.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTintMode">src_atop</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTintMode">src_atop</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="CardViewStyle.Dark" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_dark</item>
    </style>

    <style name="CardViewStyle.Light" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_light</item>
    </style>

    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>
