<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 主题（现代设计语言）：保留 Portal 品牌深灰主色 -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- M3 语义色：品牌灰 -->
        <item name="colorPrimary">#5F5F5F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E0E0</item>
        <item name="colorOnPrimaryContainer">#1E1E1E</item>
        <item name="colorSecondary">#494949</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E7E7E7</item>
        <item name="colorOnSecondaryContainer">#2A2A2A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="colorSurfaceVariant">#F0F0F0</item>
        <item name="colorOnSurfaceVariant">#5F5F5F</item>
        <item name="colorOutline">#747474</item>

        <!-- 悬浮胶囊图标色（FabBarView 取色）：浅色 90% 深度黑 -->
        <item name="portalFabIconTint">#1A1A1A</item>

        <!-- 窗口：透明状态栏 + 内容延伸 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 组件样式 -->
        <item name="searchViewStyle">@style/Portal.SearchViewStyle</item>
        <item name="sliderStyle">@style/Portal.SliderTheme</item>
        <item name="android:popupMenuStyle">@style/PortalPopupMenuStyle</item>
        <!-- 开关的**默认**样式：任何页面新增 SwitchMaterial/SwitchCompat 都自动与设置项一致 -->
        <item name="switchStyle">@style/Portal.SwitchStyle</item>
    </style>

    <!--
      开关样式 = **设置项里原本那一套**，现在提升为主题默认（不再逐处重复写）。

      `SwitchMaterial`/`SwitchCompat` 的默认样式取自主题属性 `switchStyle`
      （已核对 material 1.12.0 的 `SwitchMaterial` 构造器：`this(context, attrs, R.attr.switchStyle)`）。
      父样式必须用 **`Widget.Material3.CompoundButton.Switch`** —— 那正是 M3 主题里
      `switchStyle` 的现值（在 material 的 themes 里核实过）；写成 `…MaterialSwitch` 会**换一套外观**
      （实测：胶囊从 115×70px 变成 223×111px、滑块从浅色变深色），设置页那一排会跟着一起变样。
      下面两项也正是设置页每个开关上原本逐条写的两个属性 —— 所以这里**没有引入任何新外观**。

      收尾时已把散落的重复属性删干净：`fragment_settings.xml`(7)、
      `fragment_stamina.xml`(1)、`fragment_gnss_mock.xml`(4)。新增开关也不必再写。
    -->
    <style name="Portal.SwitchStyle" parent="Widget.Material3.CompoundButton.Switch">
        <item name="useMaterialThemeColors">true</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <!-- PopupMenu 展开动画：从右上角缩放展开/缩回（右上锚点 pivot 100%/0%） -->
    <style name="PortalPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_in_top_end</item>
        <item name="android:windowExitAnimation">@anim/popup_out_top_end</item>
    </style>

    <style name="PortalPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupAnimationStyle">@style/PortalPopupAnimation</item>
    </style>

    <style name="Portal.SliderTheme" parent="Widget.Material3.Slider" />

    <style name="Portal.SearchViewStyle" parent="Widget.AppCompat.SearchView" />

    <!-- 悬浮按钮（FAB）圆形形状覆盖：任何主题下保持圆形 -->
    <style name="PortalFabCircularOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- M3 顶栏/弹窗 overlay：surface 顶栏（现代范式，顶栏与内容同底色） -->
    <style name="AppTheme.Portal.ToolBarOverlay" parent="ThemeOverlay.Material3.Toolbar.Surface" />

    <style name="AppTheme.Portal.PopupTheme" parent="ThemeOverlay.Material3.Light" />

    <!-- 深色主题（兼容旧引用 AppTheme.Dark） -->
    <style name="AppTheme.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTintMode">src_atop</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTintMode">src_atop</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="CardViewStyle.Dark" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_dark</item>
    </style>

    <style name="CardViewStyle.Light" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_light</item>
    </style>

    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>
