<?xml version="1.0" encoding="utf-8"?>
<!--
  路线模拟页（横屏，M3 大色块版）：与竖屏同一套结构与语义 ——
  左列是整个 primaryContainer 主控色块（目标路线 + 启用开关 + 悬浮摇杆开关），
  右列是历史路线的容器色大块。两个布局的控件类型必须一致（否则 ViewBinding 会退化成 View）。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/page_gutter">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mock_location_card"
            style="@style/PortalHeroCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardPreventCornerOverlap="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_route"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/mock_route_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/none_route"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_mock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/route_mock_enable"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:thumbTint="@color/portal_switch_thumb_on_container"
                    app:trackTint="@color/portal_switch_track_on_container" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/rocker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/rocker"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:thumbTint="@color/portal_switch_thumb_on_container"
                    app:trackTint="@color/portal_switch_track_on_container" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/section_gap"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/historical_route_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/history_route"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/historical_route_card"
                style="@style/PortalSurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/historical_route_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
