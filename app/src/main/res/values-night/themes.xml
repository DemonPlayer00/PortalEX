<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色模式：Material 3 Dark，同名覆盖 values 的 AppTheme -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- M3 语义色（dark）：亮灰主色 -->
        <item name="colorPrimary">#BFBFBF</item>
        <item name="colorOnPrimary">#202020</item>
        <item name="colorPrimaryContainer">#4A4A4A</item>
        <item name="colorOnPrimaryContainer">#E6E6E6</item>
        <item name="colorSecondary">#A8A8A8</item>
        <item name="colorOnSecondary">#202020</item>
        <item name="colorSecondaryContainer">#3A3A3A</item>
        <item name="colorOnSecondaryContainer">#E6E6E6</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">#E6E6E6</item>
        <item name="colorSurfaceVariant">#2A2A2A</item>
        <item name="colorOnSurfaceVariant">#A8A8A8</item>
        <item name="colorOutline">#8A8A8A</item>

        <!-- 窗口：透明状态栏 + 内容延伸 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="searchViewStyle">@style/Portal.SearchViewStyle</item>
        <item name="sliderStyle">@style/Portal.SliderTheme</item>
    </style>

    <style name="AppTheme.Dark" parent="AppTheme" />

    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>
