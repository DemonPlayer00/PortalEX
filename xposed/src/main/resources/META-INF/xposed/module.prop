# libxposed 模块元数据（Java Properties 格式）。
# 规范来源：io.github.libxposed.api 的 package-info —— 必填 minApiVersion/targetApiVersion，
# 可选 staticScope / exceptionMode。
#
# 2026-09-18：从 101 提到 **102** —— 本模块现在要用 102 的热重载回调
# （onHotReloading/onHotReloaded，见 PortalExModule），目的是"换模块 APK 后
# system_server 无需重启"。代价是丢掉对"只实现 101 的框架"的兼容；
# 本机 LSPosed v2.2.0 (7854) 的 framework.dex 自带完整 102 面（已在设备上拆验证）。
minApiVersion=102
targetApiVersion=102

# protective：钩子抛异常时框架吞掉并记账、继续走原方法 —— 与旧 XposedBridge 的
# "回调异常不穿给宿主"语义一致（我们自己那层适配器也各自兜底，这里是第二道闸）。
exceptionMode=protective

# 刻意**不写** staticScope：配套的 scope.list 是"推荐清单"（管理器给它们打"推荐应用"标、
# 默认勾上，用户仍可增减），
# 与旧 `xposedscope` 元数据的行为一致。staticScope=true 会把作用域变成用户不可改的固定集合，
# 那时清单必须一次写全（将来加目标应用只能重新打包）—— 那是需要明确取舍的开关，不顺手打开。

