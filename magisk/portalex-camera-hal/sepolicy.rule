# magiskpolicy 的语句格式是「allow <source> <target> <class> { perms }」——
# **不是** sepolicy.conf 的 `target:class perm,perm`（写成那样会报
# "Syntax error ... Hint: allow *source_type *target_type *class *perm_set"）。
#
# 为什么需要这条：Magisk 把模块里**新增**的文件挂进 /vendor 时，若源路径是 system/**，
# 该文件被标成 system_file；而 hal_camera_default 对 system_file 没有 execute，
# shim 里 dlopen 原件会报 "couldn't map ... segment 1: Permission denied"。
allow hal_camera_default system_file file { read open getattr map execute }
allow hal_camera_default magisk_file file { read open getattr map execute }

# --- 摄像头模拟共享帧通道（详见 post-fs-data.sh 的注释与 docs/camera-mock.md §12）---
type portalex_frame_file { mlstrustedobject }
allow portalex_frame_file labeledfs filesystem associate
allow magisk portalex_frame_file dir { relabelfrom relabelto search write add_name read open getattr }
allow magisk portalex_frame_file file { relabelfrom relabelto read write open getattr create unlink map }
allow magisk shell_data_file dir { relabelfrom }
allow magisk shell_data_file file { relabelfrom }
allow untrusted_app portalex_frame_file dir { search read open getattr write add_name remove_name }
allow untrusted_app portalex_frame_file file { read write open getattr map create unlink }
allow hal_camera_default portalex_frame_file dir { search read open getattr }
allow hal_camera_default portalex_frame_file file { read write open getattr map }
allow untrusted_app shell_data_file dir { search getattr }

# shim 要读 `/data/local/tmp/portalex/portal.cfg`（bring-up 开关文件）：路径解析必须先**穿过**
# `/data/local/tmp` 本身，而它的类型是 shell_data_file —— 这里只给目录的 search，
# 不给 shell_data_file 上任何文件权限（cfg 自己带 portalex_frame_file 标签，走上面那条）。
# 实测（ACE5）：少了这一条，shim 的四个候选路径全部 fopen 失败并报"都不存在"，
# 而 dmesg 里看不到对应 avc（被 dontaudit 吞掉）—— 排查时极容易误判成"文件没写进去"。
allow hal_camera_default shell_data_file dir { search }
